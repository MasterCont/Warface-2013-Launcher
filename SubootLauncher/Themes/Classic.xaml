<!--
    Оформление «Сайт 2013» (как wf.mail.ru 2013 и сайт сервера): тёмный фон с оранжевым свечением,
    металлические кнопки, оранжевая глянцевая кнопка, панели с градиентной шапкой и оранжевым заголовком.
    Ключи ресурсов те же, что в Game.xaml — окна не зависят от выбранной темы.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра (как в Site/src/css/wf.css) -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FF15171A"/>
    <SolidColorBrush x:Key="LineBrush" Color="#FF2C3036"/>
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FFF5A300"/>
    <SolidColorBrush x:Key="CreamBrush" Color="#FFF5A300"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFC9CCD1"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF7D838C"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FFF5A300"/>
    <SolidColorBrush x:Key="OnlineBrush" Color="#FF6CC04A"/>
    <SolidColorBrush x:Key="DegradedBrush" Color="#FFE8C33A"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="#FFD9493A"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFFB3A8"/>
    <LinearGradientBrush x:Key="YellowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFCF3A" Offset="0"/>
        <GradientStop Color="#FFF5A300" Offset="0.45"/>
        <GradientStop Color="#FFE08100" Offset="0.55"/>
        <GradientStop Color="#FFF19500" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetalGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3A3F45" Offset="0"/>
        <GradientStop Color="#FF24282D" Offset="0.48"/>
        <GradientStop Color="#FF181B1F" Offset="0.52"/>
        <GradientStop Color="#FF22262A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetalHoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF464C53" Offset="0"/>
        <GradientStop Color="#FF2E3338" Offset="0.48"/>
        <GradientStop Color="#FF202429" Offset="0.52"/>
        <GradientStop Color="#FF2B3035" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoomStripBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1D2024" Offset="0"/>
        <GradientStop Color="#FF121417" Offset="1"/>
    </LinearGradientBrush>
    <!-- Фон окон: оранжевое свечение сверху, как на главной сайта -->
    <RadialGradientBrush x:Key="LobbyBackground" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.75">
        <GradientStop Color="#FF3A2A12" Offset="0"/>
        <GradientStop Color="#FF1E2124" Offset="0.45"/>
        <GradientStop Color="#FF0B0C0D" Offset="1"/>
    </RadialGradientBrush>

    <FontFamily x:Key="UiFont">Tahoma</FontFamily>
    <FontFamily x:Key="HeadFont">Bahnschrift SemiCondensed</FontFamily>

    <!-- Текст -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Логотип: серебро с оранжевым ореолом -->
    <Style x:Key="Logo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFD7DADE" Offset="0.45"/>
                    <GradientStop Color="#FF8E959E" Offset="0.55"/>
                    <GradientStop Color="#FFE9EBEE" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FFF5A300" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LogoSub" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <!-- Поля ввода -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FF0A0B0C"/>
        <Setter Property="Foreground" Value="#FFF2F2F2"/>
        <Setter Property="BorderBrush" Value="#FF3A3F45"/>
        <Setter Property="CaretBrush" Value="{StaticResource YellowBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="#FF0A0B0C"/>
        <Setter Property="Foreground" Value="#FFF2F2F2"/>
        <Setter Property="BorderBrush" Value="#FF3A3F45"/>
        <Setter Property="CaretBrush" Value="{StaticResource YellowBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Оранжевая глянцевая кнопка, как «Скачать игру» на сайте -->
    <Style x:Key="YellowButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF1D1200"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="26,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{StaticResource YellowGradient}" BorderBrush="#FF6E3C00" BorderThickness="1" CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFF5A300" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                        </Border.Effect>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="#FF3A3F45"/>
                            <Setter Property="Foreground" Value="#FF7D838C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Металлическая кнопка, как кнопки под меню сайта -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFCFD3D8"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{StaticResource MetalGradient}" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="3">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource MetalHoverGradient}"/>
                            <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладки как пункты главного меню сайта: металл, активная — оранжевый текст с чертой снизу -->
    <Style x:Key="TabToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FFDFE2E6"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Box" Background="{StaticResource MetalGradient}" BorderBrush="#FF000000" BorderThickness="1,1,1,3" Padding="18,7" Margin="0,0,2,0">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
                            <Setter TargetName="Box" Property="BorderThickness" Value="0,0,0,3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Панель: тёмный блок с чёрной рамкой и тонкой внутренней линией -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="#FF000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <!-- Черта над заголовком панели: в этой теме — тонкая оранжевая во всю ширину -->
    <Style x:Key="PanelAccent" TargetType="Rectangle">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Fill" Value="{StaticResource YellowGradient}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="-18,-18,-18,14"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
</ResourceDictionary>
