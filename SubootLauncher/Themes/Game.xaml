<!--
    Оформление в цветах интерфейса игры 1.1.1.426 (цвета сняты со скриншотов клиента):
    жёлтые полосы вкладок, серые плитки, косые жёлтые кнопки как «КУПИТЬ», кремовые заголовки.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра -->
    <Color x:Key="YellowTop">#FFFEB401</Color>
    <Color x:Key="YellowBottom">#FFEE9401</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="#FF080808"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FF0D0D0D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#FF262626"/>
    <SolidColorBrush x:Key="TileBrush" Color="#FF4F4F4F"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#FF5D5D5B"/>
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FFFCF8AF"/>
    <SolidColorBrush x:Key="SectionBrush" Color="#FF6D6D6D"/>
    <SolidColorBrush x:Key="CreamBrush" Color="#FFFDEDC0"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FFFEB401"/>
    <SolidColorBrush x:Key="OnlineBrush" Color="#FF6CC04A"/>
    <SolidColorBrush x:Key="DegradedBrush" Color="#FFE8C33A"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="#FFD9493A"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF8A7A"/>
    <LinearGradientBrush x:Key="YellowGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFCC3A" Offset="0"/>
        <GradientStop Color="{StaticResource YellowTop}" Offset="0.5"/>
        <GradientStop Color="{StaticResource YellowBottom}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoomStripBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F07ECCFC" Offset="0"/>
        <GradientStop Color="#8098D7FD" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="LobbyBackground" Center="0.2,0.05" GradientOrigin="0.2,0.05" RadiusX="1.1" RadiusY="0.9">
        <GradientStop Color="#FF2A2A2A" Offset="0"/>
        <GradientStop Color="#FF101010" Offset="0.55"/>
        <GradientStop Color="#FF050505" Offset="1"/>
    </RadialGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadFont">Segoe UI</FontFamily>

    <Style x:Key="Logo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="#FFE9EBEE"/>
    </Style>
    <Style x:Key="LogoSub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFDEDC0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Короткая жёлтая черта над заголовком панели, как у «Поставщики» -->
    <Style x:Key="PanelAccent" TargetType="Rectangle">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Fill" Value="{StaticResource YellowGradient}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,-18,0,14"/>
    </Style>

    <!-- Текст -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Поля ввода -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FF111111"/>
        <Setter Property="Foreground" Value="#FFF4F4F4"/>
        <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
        <Setter Property="CaretBrush" Value="{StaticResource YellowBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="#FF111111"/>
        <Setter Property="Foreground" Value="#FFF4F4F4"/>
        <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
        <Setter Property="CaretBrush" Value="{StaticResource YellowBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Жёлтая косая кнопка, как «КУПИТЬ» / «ПОПОЛНЕНИЕ СЧЁТА» -->
    <Style x:Key="YellowButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF1A1000"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="28,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Path x:Name="Shape" Stretch="Fill" Fill="{StaticResource YellowGradient}" Data="M 10,0 L 100,0 L 90,30 L 0,30 Z"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Fill" Value="#FF3A3A3A"/>
                            <Setter Property="Foreground" Value="#FF777777"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Серая плитка-кнопка, как предмет в арсенале: наведение — светлее -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFE0E0E0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{StaticResource TileBrush}" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource TileHoverBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладка-переключатель (Вход / Регистрация): жёлтая полоса, неактивная — приглушённая -->
    <Style x:Key="TabToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FF3A2600"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Box" Background="{StaticResource YellowGradient}" Opacity="0.5" Padding="16,6" Margin="0,0,3,0">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Окно-панель с жёлтой чертой сверху (как «Поставщики») -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="#EB080808"/>
        <Setter Property="BorderBrush" Value="#FF1E1E1E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
</ResourceDictionary>
