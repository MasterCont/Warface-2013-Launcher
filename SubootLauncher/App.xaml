<Application x:Class="SubootLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Game.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Фон окон: тёмное небо лобби -->
            <RadialGradientBrush x:Key="LobbyBackground" Center="0.2,0.05" GradientOrigin="0.2,0.05" RadiusX="1.1" RadiusY="0.9">
                <GradientStop Color="#FF2A2A2A" Offset="0"/>
                <GradientStop Color="#FF101010" Offset="0.55"/>
                <GradientStop Color="#FF050505" Offset="1"/>
            </RadialGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
