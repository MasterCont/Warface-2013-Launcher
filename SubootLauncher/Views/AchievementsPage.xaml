<UserControl x:Class="SubootLauncher.Views.AchievementsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Список -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource TileButton}" Margin="8,0,0,0" Click="OnRefresh"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ComboBox x:Name="StateBox" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" SelectionChanged="OnFilterChanged"/>
                    <ComboBox x:Name="BannerBox" DockPanel.Dock="Right" Width="120" Margin="8,0,0,0" SelectionChanged="OnFilterChanged"/>
                    <TextBox x:Name="FilterBox" ToolTip="Номер, ключ названия или тип: kills, ranking, убийства…" TextChanged="OnFilterText"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Можно выделить несколько: Ctrl или Shift + щелчок."/>
                <ListBox x:Name="AchievementsList" Style="{StaticResource Rows}" SelectionMode="Extended"
                         VirtualizingPanel.IsVirtualizing="True" SelectionChanged="OnSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Mark" Text="○" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFF2F2F2" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                    <Setter TargetName="Mark" Property="Text" Value="●"/>
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource YellowBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Действия -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="Выбранные" Style="{StaticResource Title}"/>
                <TextBlock x:Name="SelectedText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Выберите достижения в списке."/>
                <StackPanel x:Name="SelectionActions" IsEnabled="False">
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Назначить" Style="{StaticResource YellowButton}" Margin="0,0,6,6" Click="OnGive"/>
                        <Button Content="Забрать" Style="{StaticResource TileButton}" Margin="0,0,6,6" Click="OnTake"/>
                    </WrapPanel>
                    <StackPanel x:Name="ProgressPanel">
                        <TextBlock x:Name="ProgressLabel" Text="Прогресс" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Задать" Style="{StaticResource TileButton}" Margin="6,0,0,0" Click="OnSetProgress"/>
                            <TextBox x:Name="ProgressBox"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

                <Rectangle Height="1" Fill="#FF2C3036" Margin="0,18,0,12"/>

                <TextBlock Text="Все сразу" Style="{StaticResource Title}"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Назначить все" Style="{StaticResource TileButton}" Margin="0,0,6,6" Click="OnGiveAll"/>
                    <Button Content="Забрать все" Style="{StaticResource TileButton}" Margin="0,0,6,6" Click="OnTakeAll"/>
                </WrapPanel>

                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Игрок не в сети — изменения сохраняются сразу. В сети: до 5 достижений он увидит сразу с уведомлением, больше — после перезахода. Достижения за звание, «Король» и поставщиков сервер пересчитывает сам после матчей, поэтому они могут измениться."/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
