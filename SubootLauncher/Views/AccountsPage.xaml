<UserControl x:Class="SubootLauncher.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SubootLauncher.Services">
    <!-- Сохранённые учётные записи: переключение, удаление, добавление -->
    <Border Style="{StaticResource Panel}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{l:T Accounts.Title}" Style="{StaticResource Title}"/>
            <TextBlock Text="{l:T Accounts.Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <TextBlock x:Name="EmptyText" Text="{l:T Accounts.Empty}" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,10"/>
            <ItemsControl x:Name="AccountsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF1C1F23" Padding="12,8" Margin="0,0,0,4" BorderThickness="1" BorderBrush="{Binding Border}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{l:T Accounts.Switch}" Style="{StaticResource TileButton}" Margin="0,0,6,0"
                                            Visibility="{Binding SwitchVisibility}" Tag="{Binding Login}" Click="OnSwitch"/>
                                    <Button Content="{l:T Accounts.Remove}" Style="{StaticResource TileButton}" Tag="{Binding Login}" Click="OnRemove"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Login}" Foreground="#FFF2F2F2" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{l:T Accounts.Add}" Style="{StaticResource YellowButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnAdd"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
