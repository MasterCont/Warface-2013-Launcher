<UserControl x:Class="SubootLauncher.Views.PasswordPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SubootLauncher.Services">
    <Border Style="{StaticResource Panel}" Width="420" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="{l:T Password.Current}" Style="{StaticResource Muted}"/>
            <PasswordBox x:Name="OldBox" Margin="0,3,0,10"/>
            <TextBlock Text="{l:T Password.New}" Style="{StaticResource Muted}"/>
            <PasswordBox x:Name="NewBox" Margin="0,3,0,10"/>
            <TextBlock Text="{l:T Password.Repeat}" Style="{StaticResource Muted}"/>
            <PasswordBox x:Name="RepeatBox" Margin="0,3,0,12"/>
            <TextBlock Text="{l:T Password.Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            <Button x:Name="SaveButton" Content="{l:T Password.Submit}" Style="{StaticResource YellowButton}" HorizontalAlignment="Left" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Border>
</UserControl>
