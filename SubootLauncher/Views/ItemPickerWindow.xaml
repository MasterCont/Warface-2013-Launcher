<Window x:Class="SubootLauncher.Views.ItemPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор предмета" Width="560" Height="620" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource LobbyBackground}">
    <Border Style="{StaticResource Panel}" Margin="14">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ComboBox x:Name="GroupBox" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" SelectionChanged="OnFilterChanged"/>
                <Button DockPanel.Dock="Right" Content="Найти" Style="{StaticResource TileButton}" Margin="8,0,0,0" Click="OnSearch"/>
                <TextBox x:Name="SearchBox" ToolTip="Часть имени или категории, например smg, vest, ar02" PreviewKeyDown="OnSearchKey"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Выбрать" Style="{StaticResource YellowButton}" Click="OnChoose" IsDefault="True"/>
                <Button x:Name="PrevPage" DockPanel.Dock="Left" Content="‹" Width="40" Style="{StaticResource TileButton}" Click="OnPrevPage"/>
                <Button x:Name="NextPage" DockPanel.Dock="Left" Content="›" Width="40" Style="{StaticResource TileButton}" Margin="4,0,0,0" Click="OnNextPage"/>
                <TextBlock x:Name="PageText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
            </DockPanel>

            <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

            <ListBox x:Name="ItemsList" Style="{StaticResource Rows}" MouseDoubleClick="OnChoose">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="#FFF2F2F2" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="{Binding GroupTitle, Mode=OneWay}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding CategoryTitle, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
