<Window x:Class="SubootLauncher.Views.TypeConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource LobbyBackground}">
    <!-- Опасное действие: подтверждается вводом фразы вручную, кнопка активна только при точном совпадении -->
    <Border Style="{StaticResource Panel}" Margin="14">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Title}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <TextBlock x:Name="PromptText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            <TextBox x:Name="InputBox" Margin="0,4,0,12" TextChanged="OnInput"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OkButton" Style="{StaticResource YellowButton}" Margin="0,0,8,0" IsEnabled="False" Click="OnOk"/>
                <Button Content="Отмена" Style="{StaticResource TileButton}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
