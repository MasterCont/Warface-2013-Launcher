<UserControl x:Class="SubootLauncher.Views.BannedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SubootLauncher.Services">
    <!-- Вместо главной, пока у аккаунта действует бан -->
    <Border Style="{StaticResource Panel}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <!-- Знак «стоп» в цвет ошибок -->
                <Grid Width="52" Height="52" Margin="0,0,16,0" DockPanel.Dock="Left">
                    <Ellipse Stroke="{StaticResource OfflineBrush}" StrokeThickness="4"/>
                    <Line X1="12" Y1="40" X2="40" Y2="12" Stroke="{StaticResource OfflineBrush}" StrokeThickness="4"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T Ban.Title}" Style="{StaticResource Title}" FontSize="24" Foreground="{StaticResource ErrorBrush}"/>
                    <TextBlock x:Name="LoginText" Style="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" FontSize="15" Foreground="#FFF2F2F2"/>
            <TextBlock x:Name="UntilText" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="SinceText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <TextBlock Text="{l:T Ban.Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,14"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="{l:T Ban.Check}" Style="{StaticResource YellowButton}" Margin="0,0,8,0" Click="OnCheck"/>
                <Button Content="{l:T Main.Accounts}" Style="{StaticResource TileButton}" Click="OnAccounts"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
