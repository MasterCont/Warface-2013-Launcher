<Window x:Class="SubootLauncher.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource LobbyBackground}">
    <Border Style="{StaticResource Panel}" Margin="16">
        <StackPanel>
            <TextBlock Text="Смена пароля" Style="{StaticResource Title}" Margin="0,0,0,12"/>
            <TextBlock Text="Текущий пароль" Style="{StaticResource Muted}"/>
            <PasswordBox x:Name="OldBox" Margin="0,3,0,10"/>
            <TextBlock Text="Новый пароль" Style="{StaticResource Muted}"/>
            <PasswordBox x:Name="NewBox" Margin="0,3,0,10"/>
            <TextBlock Text="Повторите новый пароль" Style="{StaticResource Muted}"/>
            <PasswordBox x:Name="RepeatBox" Margin="0,3,0,12"/>
            <TextBlock Text="Пароль сменится на всех устройствах, на остальных компьютерах нужно будет войти заново."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            <Button x:Name="SaveButton" Content="Сменить" Style="{StaticResource YellowButton}" HorizontalAlignment="Left" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </Border>
</Window>
