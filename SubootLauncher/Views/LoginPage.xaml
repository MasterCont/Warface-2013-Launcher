<UserControl x:Class="SubootLauncher.Views.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SubootLauncher.Services">
    <!-- Форма по центру окна; логотип и «Настройки» — в шапке окна -->
    <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Вкладки «Вход / Регистрация» — жёлтые полосы, как вкладки классов в игре -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="LoginTab" Content="{l:T Login.Login}" Style="{StaticResource TabToggle}" IsChecked="True" Checked="OnModeChanged"/>
            <RadioButton x:Name="RegisterTab" Content="{l:T Login.Register}" Style="{StaticResource TabToggle}" Checked="OnModeChanged"/>
        </StackPanel>

        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <StackPanel x:Name="InvitePanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="{l:T Login.Invite}" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="InviteBox" Margin="0,3,0,0"/>
                    <TextBlock Text="{l:T Login.InviteHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <TextBlock Text="{l:T Login.User}" Style="{StaticResource Muted}"/>
                <TextBox x:Name="LoginBox" Margin="0,3,0,10"/>

                <TextBlock Text="{l:T Login.Password}" Style="{StaticResource Muted}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,3,0,10"/>

                <StackPanel x:Name="RepeatPanel" Visibility="Collapsed">
                    <TextBlock Text="{l:T Login.Repeat}" Style="{StaticResource Muted}"/>
                    <PasswordBox x:Name="RepeatBox" Margin="0,3,0,10"/>
                </StackPanel>

                <CheckBox x:Name="RememberBox" Content="{l:T Login.Remember}" IsChecked="True" Margin="0,0,0,14"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

                <Button x:Name="SubmitButton" Content="{l:T Login.Submit}" Style="{StaticResource YellowButton}" HorizontalAlignment="Left" IsDefault="True" Click="OnSubmit"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
