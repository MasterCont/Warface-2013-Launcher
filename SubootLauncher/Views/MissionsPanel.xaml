<UserControl x:Class="SubootLauncher.Views.MissionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Разделы: текущие миссии и настройки генерации -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="CurrentTab" Content="Текущие" Style="{StaticResource TabToggle}" IsChecked="True" Checked="OnSection"/>
            <RadioButton x:Name="SettingsTab" Content="Настройки генерации" Style="{StaticResource TabToggle}" Checked="OnSection"/>
        </StackPanel>

        <Grid>
            <!-- Текущие миссии -->
            <Grid x:Name="CurrentSection">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Перегенерировать сейчас" Style="{StaticResource YellowButton}" Margin="8,0,0,0" Click="OnRegenerate"/>
                        <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource TileButton}" Click="OnRefresh"/>
                        <TextBlock x:Name="GeneratedText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ListBox x:Name="MissionsList" Style="{StaticResource Rows}" SelectionChanged="OnMissionSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="#FFF2F2F2" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="MissionTitle" Text="Миссия" Style="{StaticResource Title}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MissionText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Миссии сменяются каждый день в 04:00 по Москве. Здесь можно поправить текущие до следующей смены."/>
                    <StackPanel x:Name="MissionActions" IsEnabled="False">
                        <TextBlock Text="Время суток (Ч:ММ)" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Задать" Style="{StaticResource TileButton}" Margin="6,0,0,0" Click="OnSetTime"/>
                            <TextBox x:Name="TimeBox"/>
                        </DockPanel>
                        <Button Content="Убрать миссию" Style="{StaticResource TileButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnRemoveMission"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Настройки генерации -->
            <DockPanel x:Name="SettingsSection" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Сохранить" Style="{StaticResource YellowButton}" Margin="0,0,6,0" Click="OnSaveSettings"/>
                        <Button Content="Сохранить и перегенерировать" Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="OnSaveAndRegenerate"/>
                        <Button Content="Исходные" Style="{StaticResource TileButton}" Click="OnResetSettings"/>
                    </StackPanel>
                    <ComboBox x:Name="TypeBox" Width="260" HorizontalAlignment="Left" SelectionChanged="OnTypeChanged"/>
                </DockPanel>

                <TextBlock x:Name="WarningsText" DockPanel.Dock="Bottom" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Карты и участки -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <CheckBox x:Name="EnabledBox" Content="Генерировать миссии этого типа" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel x:Name="PublishPanel" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Выдавать игрокам:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox x:Name="PublishEasy" Content="лёгкую" Margin="0,0,10,0"/>
                                <CheckBox x:Name="PublishNormal" Content="нормальную" Margin="0,0,10,0"/>
                                <CheckBox x:Name="PublishHard" Content="сложную"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Время суток" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SettingsTimeBox"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Доп. заданий от" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SecondaryMinBox"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="до" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SecondaryMaxBox"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Карты и участки" Style="{StaticResource Title}" Margin="0,4,0,4"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="path — проход, junction — развилка с боссом. Варианты, которым не хватает выбранных участков, генератор пропустит."/>
                            <ItemsControl x:Name="MapsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding All, Mode=TwoWay}" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding Sublevels}" Margin="20,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected, Mode=TwoWay}" Width="150" Margin="0,0,0,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Варианты миссий -->
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Все" Style="{StaticResource TileButton}" Margin="0,0,4,0" Click="OnAllGraphs"/>
                                <Button Content="Исходные" Style="{StaticResource TileButton}" Click="OnDefaultGraphs"/>
                            </StackPanel>
                            <TextBlock Text="Варианты миссий" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Сколько этапов и какой финал. ★ — входят в исходную ротацию игры."/>
                        <ListBox x:Name="GraphsList" Style="{StaticResource Rows}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#FFF2F2F2"/>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
