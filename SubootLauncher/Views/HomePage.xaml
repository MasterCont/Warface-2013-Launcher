<UserControl x:Class="SubootLauncher.Views.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SubootLauncher.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Персонаж -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <Rectangle Style="{StaticResource PanelAccent}"/>
                    <TextBlock Text="{l:T Main.Character}" Style="{StaticResource Title}" Margin="0,0,0,14"/>
                    <StackPanel x:Name="ProfilePanel" Orientation="Horizontal">
                        <!-- Звание: шестиугольник с номером -->
                        <Grid x:Name="RankBadge" Width="72" Height="80" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="RankScale"/></Grid.RenderTransform>
                            <Path Stretch="Fill" Fill="{StaticResource YellowGradient}" Data="M 50,0 L 100,25 L 100,75 L 50,100 L 0,75 L 0,25 Z"/>
                            <TextBlock x:Name="RankText" FontSize="28" FontWeight="Bold" Foreground="#FF1A1000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" MinWidth="300">
                            <TextBlock x:Name="NickText" FontSize="26" FontWeight="SemiBold" Foreground="#FFF4F4F4"/>
                            <TextBlock x:Name="ClanText" Foreground="{StaticResource YellowBrush}" Visibility="Collapsed"/>
                            <TextBlock x:Name="ExperienceText" Style="{StaticResource Muted}"/>
                            <!-- Прогресс до следующего звания -->
                            <Grid Height="6" Margin="0,6,0,2">
                                <Border Background="#FF2C3036" CornerRadius="3"/>
                                <Border Background="{StaticResource YellowGradient}" CornerRadius="3" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0"/></Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" FontSize="11"/>
                            <TextBlock x:Name="MoneyText" Margin="0,8,0,0"/>
                            <TextBlock x:Name="PlayTimeText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            <!-- Изменения с последнего обновления: «+1 250 варбаксов», «Новое звание: 5!» -->
                            <WrapPanel x:Name="DeltaPanel" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="NoProfileText" Visibility="Collapsed" TextWrapping="Wrap"
                               Text="{l:T Main.NoProfile}"/>
                </StackPanel>
            </Border>

            <!-- Серверы -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <Rectangle Style="{StaticResource PanelAccent}"/>
                    <TextBlock Text="{l:T Main.Servers}" Style="{StaticResource Title}" Margin="0,0,0,12"/>
                    <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0" SelectionChanged="OnServerSelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Box" Background="{StaticResource RoomStripBrush}" Padding="10,7" Margin="0,0,0,4" BorderThickness="2" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- Пинг справа: цвет по задержке -->
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PingText}" Foreground="{Binding PingBrush}"
                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Details}" Foreground="#FFEAF6FF" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ServersError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button Content="{l:T Common.Refresh}" Style="{StaticResource TileButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRefresh"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Низ: папка игры и «Играть» -->
        <!-- Награды за ежедневный вход: две недели, по 7 дней в строке -->
        <Border x:Name="RewardsPanel" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="14,10" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="RewardsStreakText" DockPanel.Dock="Right" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T Rewards.Title}" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T Rewards.Hint}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,2,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ItemsControl x:Name="RewardsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Cell" Margin="0,0,4,4" Padding="6,4" Background="#FF1C1F23" BorderThickness="1" BorderBrush="#FF2C3036"
                                    ToolTip="{Binding Tooltip}" Height="74">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="Mark" DockPanel.Dock="Right" Text="{Binding Mark}" FontSize="11" Foreground="{StaticResource YellowBrush}"/>
                                        <TextBlock Text="{Binding DayText}" FontSize="11" Style="{StaticResource Muted}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding CryText}" Foreground="#FFF2F2F2" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding CrownText}" Foreground="{StaticResource YellowBrush}" FontSize="11"
                                               Visibility="{Binding CrownVisibility}"/>
                                    <TextBlock Text="{Binding ItemText}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="claimed">
                                    <Setter TargetName="Cell" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="today">
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource OnlineBrush}"/>
                                    <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="next">
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
                                    <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="PlayButton" DockPanel.Dock="Right" Content="{l:T Main.Play}" Style="{StaticResource YellowButton}"
                    FontSize="22" Padding="56,12" Click="OnPlay"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="{l:T Main.GameFolder}" Style="{StaticResource Muted}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:T Common.Choose}" Style="{StaticResource TileButton}" Margin="8,0,0,0" Click="OnChooseFolder"/>
                    <TextBlock x:Name="GamePathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
