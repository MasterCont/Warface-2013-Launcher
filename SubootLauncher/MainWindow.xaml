<Window x:Class="SubootLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suboot Games — Warface 2013" Width="900" Height="560" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LobbyBackground}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: логотип и аккаунт -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,14,0" HorizontalAlignment="Right">
                    <TextBlock x:Name="AccountLogin" HorizontalAlignment="Right" Foreground="#FFF4F4F4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccountRole" HorizontalAlignment="Right" Style="{StaticResource Muted}"/>
                </StackPanel>
                <Button x:Name="StaffButton" Content="Модерация" Style="{StaticResource TileButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="OnStaff"/>
                <Button Content="Оформление" Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="OnTheme"/>
                <Button Content="Сменить пароль" Style="{StaticResource TileButton}" Margin="0,0,6,0" Click="OnChangePassword"/>
                <Button Content="Выйти" Style="{StaticResource TileButton}" Click="OnLogout"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="WARFACE 2013" Style="{StaticResource Logo}"/>
                <TextBlock Text="Частный сервер · Suboot Games" Style="{StaticResource LogoSub}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Персонаж -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <Rectangle Style="{StaticResource PanelAccent}"/>
                    <TextBlock Text="Персонаж" Style="{StaticResource Title}" Margin="0,0,0,14"/>
                    <StackPanel x:Name="ProfilePanel" Orientation="Horizontal">
                        <!-- Звание: шестиугольник с номером -->
                        <Grid Width="72" Height="80" Margin="0,0,16,0">
                            <Path Stretch="Fill" Fill="{StaticResource YellowGradient}" Data="M 50,0 L 100,25 L 100,75 L 50,100 L 0,75 L 0,25 Z"/>
                            <TextBlock x:Name="RankText" FontSize="28" FontWeight="Bold" Foreground="#FF1A1000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NickText" FontSize="26" FontWeight="SemiBold" Foreground="#FFF4F4F4"/>
                            <TextBlock x:Name="ExperienceText" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="MoneyText" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="NoProfileText" Visibility="Collapsed" TextWrapping="Wrap"
                               Text="Персонаж ещё не создан: нажмите «Играть» — игра предложит выбрать ник."/>
                </StackPanel>
            </Border>

            <!-- Серверы -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <Rectangle Style="{StaticResource PanelAccent}"/>
                    <TextBlock Text="Серверы" Style="{StaticResource Title}" Margin="0,0,0,12"/>
                    <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0" SelectionChanged="OnServerSelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Box" Background="{StaticResource RoomStripBrush}" Padding="10,7" Margin="0,0,0,4" BorderThickness="2" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Foreground="#FFEAF6FF" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ServersError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button Content="Обновить" Style="{StaticResource TileButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRefresh"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Низ: папка игры и «Играть» -->
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="PlayButton" DockPanel.Dock="Right" Content="ИГРАТЬ" Style="{StaticResource YellowButton}"
                    FontSize="22" Padding="56,12" Click="OnPlay"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="Папка игры" Style="{StaticResource Muted}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Выбрать…" Style="{StaticResource TileButton}" Margin="8,0,0,0" Click="OnChooseFolder"/>
                    <TextBlock x:Name="GamePathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
