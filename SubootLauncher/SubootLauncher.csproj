<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyName>SubootLauncher</AssemblyName>
        <Product>Suboot Games Launcher</Product>
        <Version>0.1.0</Version>
        <ApplicationIcon>Assets\suboot.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <!-- Иконка и в exe, и в окнах (Window.Icon берётся из ресурса) -->
        <Resource Include="Assets\suboot.ico"/>
        <Resource Include="Assets\suboot.png"/>
    </ItemGroup>

</Project>
